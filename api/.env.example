# Supabase Postgres — transaction pooler (runtime queries; auto-set by Supabase-Vercel integration)
POSTGRES_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase project URL (e.g. https://[project-ref].supabase.co)
SUPABASE_URL=https://[project-ref].supabase.co

# Supabase service-role key (server-side only; never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# JWT secret used to verify Supabase-issued access tokens
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Secret header value for the external scheduler endpoint (GET /jobs/tick)
SCHEDULER_SECRET=change-me-to-a-random-string

# IANA timezone used for display and wall-clock reminder conversion
APP_TIMEZONE=America/New_York
