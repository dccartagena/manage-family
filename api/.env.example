# ── Required ────────────────────────────────────────────────────────────────

# Supabase Postgres connection string. Use the *Transaction pooler* URI
# (port 6543): Supabase dashboard → Connect → Transaction pooler.
# Vercel has no IPv6 egress, so the direct connection (port 5432) will NOT
# work from Vercel. Auto-set when using the Supabase-Vercel integration.
POSTGRES_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase project URL — dashboard → Project Settings → Data API.
# Used to fetch the JWKS that verifies Supabase-issued access tokens.
SUPABASE_URL=https://[project-ref].supabase.co

# ── Required only for projects using the legacy HS256 JWT secret ───────────
# Dashboard → Project Settings → JWT Keys → Legacy JWT secret.
# New Supabase projects sign tokens with asymmetric keys verified via JWKS,
# so this can be left unset for them.
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ── Optional ────────────────────────────────────────────────────────────────

# Public URL of the deployed app, used in invite links and iCal feed URLs.
# On Vercel this defaults to the production domain — only set it when using
# a custom domain or running locally.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret header value for the external scheduler endpoint (GET /api/v1/jobs/tick).
# Only needed if you wire up an external cron for reminders.
SCHEDULER_SECRET=change-me-to-a-random-string
