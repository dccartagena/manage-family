# Supabase Postgres — direct connection (migrations, seeders)
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Supabase Postgres — connection pooler (runtime queries; required for serverless)
DATABASE_POOL_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase project URL (e.g. https://[project-ref].supabase.co)
SUPABASE_URL=https://[project-ref].supabase.co

# Supabase service-role key (server-side only; never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# JWT secret used to verify Supabase-issued access tokens
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Secret header value for the external scheduler endpoint (GET /jobs/tick)
SCHEDULER_SECRET=change-me-to-a-random-string

# IANA timezone used for display and wall-clock reminder conversion
APP_TIMEZONE=America/New_York
