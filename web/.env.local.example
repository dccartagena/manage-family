# Supabase project URL — dashboard → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co

# Supabase anon/public key — dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Base URL of the FastAPI service.
# Leave UNSET on Vercel — the frontend and API share one domain and /api/* is
# routed to the Python function. Set to http://localhost:8000 for local dev.
NEXT_PUBLIC_API_URL=http://localhost:8000
